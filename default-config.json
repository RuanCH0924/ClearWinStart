{
    "version": "1.0.0",
    "description": "ClearWinStart 默认配置文件 - 可被用户配置覆盖",

    "user_name": "",

    "paths": {
        "user_start_menu": "%APPDATA%\\Microsoft\\Windows\\Start Menu\\Programs",
        "system_start_menu": "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs"
    },

    "neglect_folders": [
        "Accessibility",
        "Accessories",
        "Administrative",
        "Administrative Tools",
        "desktop.ini",
        "Maintenance",
        "StartUp",
        "Startup",
        "System Tools",
        "Tools",
        "Windows PowerShell"
    ],

    "delete_keywords": [],
    "check_shortcuts": false,
    "dry_run": false
}
